# Copy to .env for local development. Keep .env private and never commit it.
GOOGLE_SHEET_ID=your-private-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"service-account@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n"}
# Set this after creating the private leaderboard tab.
LEADERBOARD_RANGE='Leaderboard!A:Z'
